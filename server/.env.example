PORT=5001
MONGO_URI=mongodb://127.0.0.1:27018/taskflow
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# Session cookie policy. Use 'lax' when the site and API share a domain, or
# 'none' when they are on different sites (required for cross-site cookies,
# and only works over HTTPS). Defaults to 'lax'.
COOKIE_SAME_SITE=lax

# In production CLIENT_URL may list several origins, comma-separated:
# CLIENT_URL=https://taskflow.vercel.app,https://taskflow-git-main.vercel.app

# For MongoDB Atlas, use instead:
# MONGO_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/taskflow?retryWrites=true&w=majority
